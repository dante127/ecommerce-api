# PostgreSQL Database
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Stripe Test Configuration
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT Configuration
JWT_KEY=SuperSecretDevelopmentKeyForECommerceApiTestingOnlyMustBeLongerThan32Bytes!
JWT_ISSUER=ECommerceApi
JWT_AUDIENCE=ECommerceClient

# NOTE: docker-compose.yml currently consumes only STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET from the environment. The JWT_* and POSTGRES_* values
# above are documentation only: docker-compose hardcodes its own local values.
# Either read these variables in docker-compose.yml or treat that file as canonical.

# Stripe mock mode. It is ON by default in Development and can never be enabled
# outside Development. Set STRIPE_USE_MOCK_GATEWAY=false (env var
# Stripe__UseMockGateway) to exercise real Stripe test keys locally.
